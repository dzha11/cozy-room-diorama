{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure",
            "type": "shell",
            "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release",
            "problemMatcher": []
        },
        {
            "label": "CMake: build",
            "type": "shell",
            "command": "cmake --build build -j",
            "dependsOn": "CMake: configure",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run CozyRoom",
            "type": "shell",
            "command": "./build/CozyRoom",
            "windows": { "command": ".\\build\\Release\\CozyRoom.exe" },
            "dependsOn": "CMake: build",
            "problemMatcher": []
        }
    ]
}
